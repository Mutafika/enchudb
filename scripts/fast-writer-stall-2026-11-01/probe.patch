index efdf564..2fc6b64 100644
--- a/crates/enchudb-oplog/src/lib.rs
+++ b/crates/enchudb-oplog/src/lib.rs
@@ -155,3 +155,49 @@ impl Ord for Hlc {
         self.cmp_key().cmp(&other.cmp_key())
     }
 }
+
+/// PROBE #683: 段ごとの時刻 (ENCHU_T683=<file> の時だけ控え、 `dump` で書き出す)。 commit しない。
+#[doc(hidden)]
+pub mod t683 {
+    use std::sync::{Mutex, OnceLock};
+    use std::time::Instant;
+    static T0: OnceLock<Instant> = OnceLock::new();
+    type Ev = (u64, u8, &'static str, u64, u64);
+    static BUF: Mutex<Vec<Ev>> = Mutex::new(Vec::new());
+    fn on() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| {
+            T0.get_or_init(Instant::now);
+            std::env::var_os("ENCHU_T683").is_some()
+        })
+    }
+    thread_local!(static K: u8 = match std::thread::current().name() {
+        Some("enchudb-consumer") => b'c',
+        Some(n) if n.contains("notif") => b'n',
+        _ => b'w',
+    });
+    #[inline]
+    pub fn now() -> Instant {
+        Instant::now()
+    }
+    /// `t` から今までの区間 (µs) を `tag` で控える。 `x` は付けたい数。
+    pub fn span(tag: &'static str, t: Instant, x: u64) {
+        if !on() {
+            return;
+        }
+        let t0 = *T0.get().unwrap();
+        let s = t.saturating_duration_since(t0).as_micros() as u64;
+        let d = t.elapsed().as_micros() as u64;
+        let k = K.with(|k| *k);
+        BUF.lock().unwrap().push((s, k, tag, d, x));
+    }
+    pub fn dump() {
+        let Some(p) = std::env::var_os("ENCHU_T683") else { return };
+        let buf = std::mem::take(&mut *BUF.lock().unwrap());
+        let mut out = String::new();
+        for (s, k, tag, d, x) in buf {
+            out.push_str(&format!("{s} {} {tag} {d} {x}\n", k as char));
+        }
+        let _ = std::fs::write(p, out);
+    }
+}
